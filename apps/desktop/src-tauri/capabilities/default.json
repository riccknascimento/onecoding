{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "M\u00ednimo necess\u00e1rio: os comandos do app e arrastar a janela. Sem shell, FS, HTTP, di\u00e1logo, eventos ou caminhos.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-store-status",
    "allow-orchestrator-provider-status",
    "allow-detect-local-gateway",
    "allow-approve-executable",
    "allow-list-workspaces",
    "allow-authorize-workspace",
    "allow-start-run",
    "allow-cancel-run",
    "allow-list-runs",
    "allow-get-run",
    "core:window:allow-start-dragging"
  ]
}
