# Copie para .env (ao lado do docker-compose.yml). O Compose lê este arquivo automaticamente em deploy, rollback e migrate.
# Produção:
CENTRAL_ENV_FILE=/etc/oneagent-central/central.env
CADDY_CONFIG=Caddyfile
ACME_EMAIL=ti@exemplo.invalido
WEB_DIR=./web
# Teste local (não público): CENTRAL_ENV_FILE=/opt/oneagent/test.central.env e CADDY_CONFIG=test.Caddyfile
