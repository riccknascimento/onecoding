# Modelo de /etc/oneagent-central/central.env (permissão 600, dono root). NÃO commitar o arquivo real.
# A senha do PostgreSQL vem de /etc/oneagent-central/db.env e entra aqui pelo operador, nunca pelo repositório.
ONEAGENT_CENTRAL_DATABASE_URL=postgres://oneagent_central:SENHA@127.0.0.1:5432/oneagent_central
ONEAGENT_CENTRAL_BIND=127.0.0.1:8787
ONEAGENT_CENTRAL_COOKIE_SECURE=1
ONEAGENT_CENTRAL_ALLOWED_ORIGINS=https://app.oneagente.tech
ONEAGENT_CENTRAL_TRUSTED_PROXIES=127.0.0.1
RUST_LOG=info
